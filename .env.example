# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Configurations
GEMINI_SCOPE_MODEL=gemini-1.5-flash
GEMINI_BLOCKER_MODEL=gemini-1.5-flash
GEMINI_DOCGEN_MODEL=gemini-1.5-flash
GEMINI_CHAT_MODEL=gemini-1.5-flash

# Groq API Key
GROQ_API_KEY=your_groq_api_key_here

# Groq Risk Model Configuration
GROQ_RISK_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b

# Agent Timeout in Seconds
AGENT_TIMEOUT_SECONDS=60

# Embedding Model Name
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Persistent Chroma Vector Store Path
CHROMA_PERSIST_DIR=./data/chroma
